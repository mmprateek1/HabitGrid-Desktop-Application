{
  "name": "habitgrid",
  "productName": "HabitGrid",
  "private": true,
  "version": "1.2.0",
  "description": "Simple monthly habit grid desktop tracker with growth graphs",
  "author": "HabitGrid",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "start": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:react": "vite build",
    "build:electron": "electron-builder --win",
    "build": "npm run build:react && npm run build:electron",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.habitgrid.app",
    "productName": "HabitGrid",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HabitGrid",
      "artifactName": "HabitGrid-Setup-v${version}.${ext}"
    },
    "portable": {
      "artifactName": "HabitGrid-Portable-v${version}.${ext}"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
